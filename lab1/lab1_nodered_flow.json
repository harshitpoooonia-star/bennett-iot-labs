[
 {
  "id": "tab1",
  "type": "tab",
  "label": "Lab 1 \u2013 IoT Data Acquisition"
 },
 {
  "id": "broker",
  "type": "mqtt-broker",
  "name": "Local Mosquitto",
  "broker": "localhost",
  "port": "1883",
  "clientid": "",
  "autoConnect": true,
  "usetls": false,
  "protocolVersion": "4",
  "keepalive": "60",
  "cleansession": true
 },
 {
  "id": "uitab",
  "type": "ui_tab",
  "name": "Home",
  "icon": "dashboard",
  "order": 1
 },
 {
  "id": "grp",
  "type": "ui_group",
  "name": "Sensor Data",
  "tab": "uitab",
  "order": 1,
  "disp": true,
  "width": "12"
 },
 {
  "id": "grp2",
  "type": "ui_group",
  "name": "Alerts",
  "tab": "uitab",
  "order": 2,
  "disp": true,
  "width": "6"
 },
 {
  "id": "base",
  "type": "ui_base",
  "theme": {
   "name": "theme-light"
  },
  "site": {
   "name": "CSET480 Lab 1 \u2013 IoT Dashboard",
   "hideToolbar": "false",
   "allowSwipe": "false",
   "lockMenu": "false",
   "allowTempTheme": "true",
   "dateFormat": "DD/MM/YYYY",
   "sizes": {
    "sx": 48,
    "sy": 48,
    "gx": 6,
    "gy": 6,
    "cx": 6,
    "cy": 6,
    "px": 0,
    "py": 0
   }
  }
 },
 {
  "id": "cm1",
  "type": "comment",
  "z": "tab1",
  "name": "Part F \u2013 core pipeline",
  "x": 150,
  "y": 40,
  "wires": []
 },
 {
  "id": "mqT",
  "type": "mqtt in",
  "z": "tab1",
  "x": 150,
  "y": 120,
  "wires": [
   [
    "fnT",
    "dbgT",
    "chart",
    "swT",
    "csvF"
   ]
  ],
  "name": "Temperature",
  "topic": "iot/sensor/temperature",
  "qos": "0",
  "datatype": "utf8",
  "broker": "broker",
  "nl": false,
  "rap": true,
  "rh": 0,
  "inputs": 0
 },
 {
  "id": "fnT",
  "type": "function",
  "z": "tab1",
  "x": 400,
  "y": 100,
  "wires": [
   [
    "gT"
   ]
  ],
  "name": "Round 1 dp",
  "func": "msg.payload = parseFloat(msg.payload).toFixed(1);\nreturn msg;",
  "outputs": 1
 },
 {
  "id": "gT",
  "type": "ui_gauge",
  "z": "tab1",
  "x": 620,
  "y": 100,
  "wires": [],
  "group": "grp",
  "order": 1,
  "width": 6,
  "height": 4,
  "gtype": "gage",
  "title": "Temperature (\u00b0C)",
  "label": "\u00b0C",
  "format": "{{value}}",
  "min": 0,
  "max": 50,
  "colors": [
   "#00b500",
   "#e6e600",
   "#ca3838"
  ],
  "seg1": "30",
  "seg2": "35",
  "name": "Temp gauge"
 },
 {
  "id": "dbgT",
  "type": "debug",
  "z": "tab1",
  "x": 410,
  "y": 160,
  "wires": [],
  "name": "raw temperature",
  "active": true,
  "tosidebar": true,
  "console": true,
  "tostatus": true,
  "complete": "payload",
  "targetType": "msg",
  "statusVal": "payload",
  "statusType": "auto"
 },
 {
  "id": "chart",
  "type": "ui_chart",
  "z": "tab1",
  "x": 610,
  "y": 200,
  "wires": [],
  "group": "grp",
  "order": 3,
  "width": 12,
  "height": 5,
  "label": "Temperature Trend",
  "chartType": "line",
  "legend": "false",
  "xformat": "HH:mm:ss",
  "interpolate": "linear",
  "nodata": "Waiting for data\u2026",
  "ymin": "0",
  "ymax": "50",
  "removeOlder": "5",
  "removeOlderPoints": "",
  "removeOlderUnit": "60",
  "cutout": 0,
  "useOneColor": false,
  "colors": [
   "#1f77b4",
   "#aec7e8",
   "#ff7f0e",
   "#2ca02c",
   "#98df8a",
   "#d62728",
   "#ff9896",
   "#9467bd",
   "#c5b0d5"
  ],
  "useOldStyle": false,
  "outputs": 1,
  "name": "Temp chart"
 },
 {
  "id": "mqH",
  "type": "mqtt in",
  "z": "tab1",
  "x": 150,
  "y": 300,
  "wires": [
   [
    "fnH",
    "dbgH",
    "csvF"
   ]
  ],
  "name": "Humidity",
  "topic": "iot/sensor/humidity",
  "qos": "0",
  "datatype": "utf8",
  "broker": "broker",
  "nl": false,
  "rap": true,
  "rh": 0,
  "inputs": 0
 },
 {
  "id": "fnH",
  "type": "function",
  "z": "tab1",
  "x": 400,
  "y": 280,
  "wires": [
   [
    "gH"
   ]
  ],
  "name": "Round 1 dp",
  "func": "msg.payload = parseFloat(msg.payload).toFixed(1);\nreturn msg;",
  "outputs": 1
 },
 {
  "id": "gH",
  "type": "ui_gauge",
  "z": "tab1",
  "x": 620,
  "y": 280,
  "wires": [],
  "group": "grp",
  "order": 2,
  "width": 6,
  "height": 4,
  "gtype": "gage",
  "title": "Humidity (%)",
  "label": "%",
  "format": "{{value}}",
  "min": 0,
  "max": 100,
  "colors": [
   "#ca3838",
   "#00b500",
   "#1f77b4"
  ],
  "seg1": "30",
  "seg2": "70",
  "name": "Hum gauge"
 },
 {
  "id": "dbgH",
  "type": "debug",
  "z": "tab1",
  "x": 400,
  "y": 340,
  "wires": [],
  "name": "raw humidity",
  "active": true,
  "tosidebar": true,
  "console": true,
  "tostatus": true,
  "complete": "payload",
  "targetType": "msg",
  "statusVal": "payload",
  "statusType": "auto"
 },
 {
  "id": "cm2",
  "type": "comment",
  "z": "tab1",
  "name": "Practice Task 1 \u2013 CSV logging",
  "x": 170,
  "y": 420,
  "wires": []
 },
 {
  "id": "csvF",
  "type": "function",
  "z": "tab1",
  "x": 420,
  "y": 460,
  "wires": [
   [
    "file"
   ]
  ],
  "name": "Format CSV row",
  "func": "const s = msg.topic.split('/').pop();\nmsg.payload = new Date().toISOString() + ',' + s + ',' + msg.payload;\nreturn msg;",
  "outputs": 1
 },
 {
  "id": "file",
  "type": "file",
  "z": "tab1",
  "x": 680,
  "y": 460,
  "wires": [
   []
  ],
  "name": "Append sensor_log.csv",
  "filename": "sensor_log.csv",
  "filenameType": "str",
  "appendNewline": true,
  "createDir": true,
  "overwriteFile": "false",
  "encoding": "utf8"
 },
 {
  "id": "cm3",
  "type": "comment",
  "z": "tab1",
  "name": "Practice Task 2 \u2013 threshold alert (> 35 \u00b0C)",
  "x": 210,
  "y": 540,
  "wires": []
 },
 {
  "id": "swT",
  "type": "switch",
  "z": "tab1",
  "x": 400,
  "y": 580,
  "wires": [
   [
    "alFn"
   ]
  ],
  "name": "temp > 35",
  "property": "payload",
  "propertyType": "msg",
  "rules": [
   {
    "t": "gt",
    "v": "35",
    "vt": "num"
   }
  ],
  "checkall": "true",
  "repair": false,
  "outputs": 1
 },
 {
  "id": "alFn",
  "type": "function",
  "z": "tab1",
  "x": 580,
  "y": 580,
  "wires": [
   [
    "toast",
    "dbgA",
    "alTxt"
   ]
  ],
  "name": "Build alert",
  "func": "msg.topic = '\u26a0 High Temperature Alert';\nmsg.payload = 'Temperature is ' + parseFloat(msg.payload).toFixed(1) + ' \u00b0C (threshold 35 \u00b0C)';\nreturn msg;",
  "outputs": 1
 },
 {
  "id": "toast",
  "type": "ui_toast",
  "z": "tab1",
  "x": 790,
  "y": 560,
  "wires": [],
  "position": "top right",
  "displayTime": "3",
  "highlight": "#ca3838",
  "sendall": true,
  "outputs": 0,
  "ok": "OK",
  "cancel": "",
  "raw": false,
  "topic": "",
  "name": "Dashboard notification"
 },
 {
  "id": "alTxt",
  "type": "ui_text",
  "z": "tab1",
  "x": 790,
  "y": 620,
  "wires": [],
  "group": "grp2",
  "order": 1,
  "width": 6,
  "height": 1,
  "name": "Last alert",
  "label": "Last alert:",
  "format": "{{msg.payload}}",
  "layout": "col-center"
 },
 {
  "id": "dbgA",
  "type": "debug",
  "z": "tab1",
  "x": 780,
  "y": 680,
  "wires": [],
  "name": "ALERT",
  "active": true,
  "tosidebar": true,
  "console": true,
  "tostatus": false,
  "complete": "payload",
  "targetType": "msg"
 }
]